{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "**/.env",
        "**/.env.*local",
        "**/package.json"
    ],
    "globalEnv": [
        "STRAPI_URL",
        "WEBPACK_CACHE_TYPE"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**",
                "public/**"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "dev": {
            "dependsOn": [],
            "cache": false,
            "persistent": true
        },
        "start": {
            "dependsOn": [
                "^build"
            ],
            "cache": false,
            "persistent": true
        }
    }
}